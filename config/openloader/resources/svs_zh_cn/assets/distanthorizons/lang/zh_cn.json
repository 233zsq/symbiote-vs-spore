 "distanthorizons.config.title": "Distant Horizons 配置",
 "distanthorizons.config.client": "客户端",
 "distanthorizons.config.client.quickEnableRendering": "启用渲染",
 "distanthorizons.config.client.quickEnableRendering.@tooltip": "启用后，Distant Horizons 将在原版渲染距离之外渲染 LOD。",
 "distanthorizons.config.client.quickShowWorldGenProgress": "显示 LOD 生成/导入进度",
 "distanthorizons.config.client.quickShowWorldGenProgress.@tooltip": "启用后，世界生成/导入进度将在运行时显示在屏幕上。",
 "distanthorizons.config.client.qualityPresetSetting": "画质预设",
 "distanthorizons.config.client.qualityPresetSetting.@tooltip": "调整多项图形设置以快速更改 Distant Horizons 的渲染质量。\n\n如果 GPU 占用率达到上限或帧率出现问题，请调低此设置。",
 "distanthorizons.config.client.threadPresetSetting": "CPU 负载",
 "distanthorizons.config.client.threadPresetSetting.@tooltip": "调整 Distant Horizons 使用的线程数量。\n\n提高此设置可提升远景生成器的速度和 LOD 加载速度，\n但也会增加 CPU/内存占用，并可能导致卡顿。\n\n注意：这是与 CPU 相关的设置。\n它对 2 核 CPU 和 64 核 CPU 造成的压力是相同的。",
 "distanthorizons.config.client.optionsButton": "显示选项按钮",
 "distanthorizons.config.client.optionsButton.@tooltip": "在视野（FOV）按钮左侧显示配置按钮",
 "distanthorizons.config.client.advanced": "高级选项",
 "distanthorizons.config.client.advanced.graphics": "图形",
 "distanthorizons.config.client.advanced.worldGenerator": "世界生成器",
 "distanthorizons.config.client.advanced.server": "服务器",
 "distanthorizons.config.client.advanced.lodBuilding": "LOD 构建",
 "distanthorizons.config.client.advanced.multiThreading": "多线程",
 "distanthorizons.config.client.advanced.logging": "日志",
 "distanthorizons.config.client.advanced.graphics.quality": "质量",
 "distanthorizons.config.client.advanced.graphics.quality.lodChunkRenderDistanceRadius": "LOD 区块渲染距离半径",
 "distanthorizons.config.client.advanced.graphics.quality.lodChunkRenderDistanceRadius.@tooltip": "Distant Horizons 的渲染距离，以区块为单位。\n\n注意：这是一个尽力而为的数值。\n实际渲染距离可能高于或低于此数值，\n取决于你的其他图形设置。",
 "distanthorizons.config.client.advanced.graphics.quality.horizontalQuality": "LOD 质量衰减距离",
 "distanthorizons.config.client.advanced.graphics.quality.horizontalQuality.@tooltip": "表示 LOD 质量衰减点之间的距离。\n\n更高的设置会增大衰减点之间的距离，\n但会增加内存和 GPU 占用。",
 "distanthorizons.config.client.advanced.graphics.quality.maxHorizontalResolution": "最大水平分辨率",
 "distanthorizons.config.client.advanced.graphics.quality.maxHorizontalResolution.@tooltip": "LOD 可渲染的最大细节。\n\n§6最快：§r 区块\n§6最精细：§r 方块",
 "distanthorizons.config.client.advanced.graphics.quality.verticalQuality": "垂直质量",
 "distanthorizons.config.client.advanced.graphics.quality.verticalQuality.@tooltip": "LOD 表现悬垂结构、洞穴、悬崖峭壁等的效果。\n\n更高的选项会增加内存和 GPU 占用。",
 "distanthorizons.config.client.advanced.graphics.quality.useCameraPositionForQualityDropOff": "使用相机位置计算质量衰减",
 "distanthorizons.config.client.advanced.graphics.quality.useCameraPositionForQualityDropOff.@tooltip": "启用后，DH 将在确定 LOD 质量衰减时\n尝试使用相机位置。\n禁用后，DH 将使用玩家位置。\n\n启用有助于自由视角（Free-Cam）类模组正确渲染。\n禁用有助于多相机类模组正确渲染（如沉浸式传送门或相机模组）。",
 "distanthorizons.config.client.advanced.graphics.quality.increaseQualityWhenZoomedIn": "变焦时提高质量",
 "distanthorizons.config.client.advanced.graphics.quality.increaseQualityWhenZoomedIn.@tooltip": "启用后，当相机处于变焦状态时（如使用望远镜或变焦模组），\nLOD 质量将会提高。\n\n仅影响相机视野内可见的 LOD。\n\n变焦时 LOD 会加载到与你靠近它时相同的细节等级。",
 "distanthorizons.config.client.advanced.graphics.quality.maxZoomQualityIncrease": "最大变焦质量提升",
 "distanthorizons.config.client.advanced.graphics.quality.maxZoomQualityIncrease.@tooltip": "变焦最多可提升多少个细节等级的 LOD 质量。\n更高的数值允许更强的变焦渲染出更清晰的地形，\n但会在变焦时增加内存和 GPU 占用。\n\n原版望远镜需要 4 个细节等级才能达到完整质量。",
 "distanthorizons.config.client.advanced.graphics.quality.horizontalScale": "水平缩放",
 "distanthorizons.config.client.advanced.graphics.quality.horizontalScale.@tooltip": "LOD 质量衰减的速度。\n\n更大的数值会改善远处地形的外观，\n但会增加内存和 GPU 占用。",
 "distanthorizons.config.client.advanced.graphics.quality.transparency": "透明度",
 "distanthorizons.config.client.advanced.graphics.quality.lodShading": "LOD 明暗着色",
 "distanthorizons.config.client.advanced.graphics.quality.lodShading.@tooltip": "定义 LOD 的明暗着色方式。\n可用于提高光影包兼容性。",
 "distanthorizons.config.client.advanced.graphics.quality.grassSideRendering": "草方块侧面渲染",
 "distanthorizons.config.client.advanced.graphics.quality.grassSideRendering.@tooltip": "草方块 LOD 的侧面和底面应如何渲染？",
 "distanthorizons.config.client.advanced.graphics.quality.ditherDhFade": "渐隐近距离 DH LOD",
 "distanthorizons.config.client.advanced.graphics.quality.ditherDhFade.@tooltip": "启用后，LOD 会随着你靠近而逐渐淡出。\n禁用后，LOD 会在距相机一定距离处突然截断。\n此设置受原版过度绘制预防配置的影响。",
 "distanthorizons.config.client.advanced.graphics.quality.vanillaFadeMode": "原版渐隐模式",
 "distanthorizons.config.client.advanced.graphics.quality.vanillaFadeMode.@tooltip": "原版 Minecraft 应如何渐变过渡到 Distant Horizons 的 LOD？\n\nNONE：最快，DH 与 MC 渲染之间会有明显的边界。\nSINGLE_PASS：在 MC 的透明渲染通道之后渐隐，水下的不透明方块不会被渐隐。\nDOUBLE_PASS：最慢，在 MC 的不透明和透明渲染通道之后均渐隐，过渡最平滑。",
 "distanthorizons.config.client.advanced.graphics.quality.dhFadeFarClipPlane": "在远裁剪平面前渐隐",
 "distanthorizons.config.client.advanced.graphics.quality.dhFadeFarClipPlane.@tooltip": "DH 是否应在到达远裁剪平面之前淡出？\n这有助于防止 DH 云层在远处被截断。",
 "distanthorizons.config.client.advanced.graphics.quality.brightnessMultiplier": "亮度倍率",
 "distanthorizons.config.client.advanced.graphics.quality.brightnessMultiplier.@tooltip": "LOD 颜色的亮度。\n\n0 = 黑色\n1 = 正常\n2 = 接近白色",
 "distanthorizons.config.client.advanced.graphics.quality.saturationMultiplier": "饱和度倍率",
 "distanthorizons.config.client.advanced.graphics.quality.saturationMultiplier.@tooltip": "LOD 颜色的饱和度。\n\n0 = 黑白\n1 = 正常\n2 = 鲜艳",
 "distanthorizons.config.client.advanced.graphics.quality.lodBiomeBlending": "生物群系过渡",
 "distanthorizons.config.client.advanced.graphics.quality.lodBiomeBlending.@tooltip": "与原版生物群系过渡设置相同，但作用于 LOD 区域。\n\n注意：任何大于 '0' 的值都会降低 LOD 加载速度。\n\n'0' 相当于原版生物群系过渡 '1x1'，\n'1' 相当于原版生物群系过渡 '3x3'，\n'2' 相当于原版生物群系过渡 '5x5'……\n",
 "distanthorizons.config.client.advanced.graphics.enableSsao": "启用环境光遮蔽",
 "distanthorizons.config.client.advanced.graphics.enableSsao.@tooltip": "环境光遮蔽可增加方块光照的层次感。",
 "distanthorizons.config.client.advanced.graphics.enableAntiAliasing": "启用抗锯齿",
 "distanthorizons.config.client.advanced.graphics.enableAntiAliasing.@tooltip": "启用抗锯齿可平滑边缘，并减少移动时的闪烁。",
 "distanthorizons.config.client.advanced.graphics.genericRendering": "通用对象渲染",
 "distanthorizons.config.client.advanced.graphics.genericRendering.enableGenericRendering": "启用通用渲染",
 "distanthorizons.config.client.advanced.graphics.genericRendering.enableGenericRendering.@tooltip": "启用后，非地形对象将由 DH 渲染。\n例如信标光柱和云。",
 "distanthorizons.config.client.advanced.graphics.genericRendering.enableBeaconRendering": "启用信标渲染",
 "distanthorizons.config.client.advanced.graphics.genericRendering.beaconRenderHeight": "信标渲染高度",
 "distanthorizons.config.client.advanced.graphics.genericRendering.beaconRenderHeight.@tooltip": "设置信标渲染的最大高度。需要重新加载世界才能生效。",
 "distanthorizons.config.client.advanced.graphics.genericRendering.expandDistantBeacons": "放大远处信标",
 "distanthorizons.config.client.advanced.graphics.genericRendering.expandDistantBeacons.@tooltip": "启用后，LOD 信标光柱在极远距离时会渲染得更宽，\n更容易被看到。\n禁用后，所有 LOD 信标光柱始终只有 1 格宽。",
 "distanthorizons.config.client.advanced.graphics.genericRendering.enableBeaconRendering.@tooltip": "启用后，将渲染 LOD 信标光柱。",
 "distanthorizons.config.client.advanced.graphics.genericRendering.enableCloudRendering": "启用云渲染",
 "distanthorizons.config.client.advanced.graphics.genericRendering.enableCloudRendering.@tooltip": "启用后，将渲染 LOD 云层。",
 "distanthorizons.config.client.advanced.graphics.genericRendering.dimensionEnabledCloudRenderingCsv": "启用云渲染的维度 CSV 列表",
 "distanthorizons.config.client.advanced.graphics.genericRendering.dimensionEnabledCloudRenderingCsv.@tooltip": "以逗号分隔的维度资源位置列表，DH 云层将在这些维度中渲染。\n\n示例：\"minecraft:overworld,minecraft:the_end\"\n\n更改需要重新加载世界。",
 "distanthorizons.config.client.advanced.graphics.genericRendering.enableMultiLayerClouds": "启用多层云",
 "distanthorizons.config.client.advanced.graphics.genericRendering.enableMultiLayerClouds.@tooltip": "禁用 = DH 将像原版 Minecraft 一样渲染单层云。\n启用 = DH 将在不同高度渲染 3 层云。",
 "distanthorizons.config.client.advanced.graphics.fog": "雾",
 "distanthorizons.config.client.advanced.graphics.fog.enableDhFog": "启用 Distant Horizons 雾",
 "distanthorizons.config.client.advanced.graphics.fog.enableDhFog.@tooltip": "决定是否在 DH 的 LOD 上绘制雾。",
 "distanthorizons.config.client.advanced.graphics.fog.colorMode": "雾颜色模式",
 "distanthorizons.config.client.advanced.graphics.fog.colorMode.@tooltip": "LOD 上雾的颜色。",
 "distanthorizons.config.client.advanced.graphics.fog.enableVanillaFog": "启用原版雾",
 "distanthorizons.config.client.advanced.graphics.fog.enableVanillaFog.@tooltip": "§6启用：§r Minecraft 像往常一样渲染雾。\n§6禁用：§r 禁用 Minecraft 在原版区块上的雾。\n\n可能会与修改雾的其他模组产生冲突。",
 "distanthorizons.config.client.advanced.graphics.fog.advancedFog": "高级雾选项",
 "distanthorizons.config.client.advanced.graphics.fog.farFogStart": "雾起始",
 "distanthorizons.config.client.advanced.graphics.fog.farFogStart.@tooltip": "雾应从哪里开始？\n\n  '0.0'：雾从玩家位置开始。\n  '1.0'：雾起始圆恰好内切于 LOD 渲染距离正方形。\n'1.414'：LOD 渲染距离正方形恰好内切于雾起始圆。\n",
 "distanthorizons.config.client.advanced.graphics.fog.farFogEnd": "雾终止",
 "distanthorizons.config.client.advanced.graphics.fog.farFogEnd.@tooltip": "雾应在哪里结束？\n\n  '0.0'：雾在玩家位置结束。\n  '1.0'：雾终止圆恰好内切于 LOD 渲染距离正方形。\n'1.414'：LOD 渲染距离正方形恰好内切于雾终止圆。\n",
 "distanthorizons.config.client.advanced.graphics.fog.farFogMin": "雾最小值",
 "distanthorizons.config.client.advanced.graphics.fog.farFogMin.@tooltip": "雾的最小浓度是多少？\n\n  '0.0'：完全没有雾。\n  '1.0'：完全为雾颜色。\n",
 "distanthorizons.config.client.advanced.graphics.fog.farFogMax": "雾最大值",
 "distanthorizons.config.client.advanced.graphics.fog.farFogMax.@tooltip": "雾的最大浓度是多少？\n\n  '0.0'：完全没有雾。\n  '1.0'：完全为雾颜色。\n",
 "distanthorizons.config.client.advanced.graphics.fog.farFogFalloff": "雾衰减",
 "distanthorizons.config.client.advanced.graphics.fog.farFogFalloff.@tooltip": "雾浓度应如何计算？\n\nLINEAR：基于距离的线性计算（将忽略 'density'）\nEXPONENTIAL：1/(e^(distance*density))\nEXPONENTIAL_SQUARED：1/(e^((distance*density)^2))\n",
 "distanthorizons.config.client.advanced.graphics.fog.farFogDensity": "雾密度",
 "distanthorizons.config.client.advanced.graphics.fog.farFogDensity.@tooltip": "雾的密度是多少？",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog": "高度雾选项",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMixMode": "高度雾混合模式",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMixMode.@tooltip": "定义高度对雾的影响方式。\n不确定时建议从 SPHERICAL、ADDITION 或 MAX 开始。\n\nSPHERICAL：基于相机距离计算雾。\nCYLINDRICAL：忽略高度，基于水平距离计算雾。\nMAX：max(heightFog, farFog)\nADDITION：heightFog + farFog\nMULTIPLY：heightFog * farFog\nINVERSE_MULTIPLY：1 - (1-heightFog) * (1-farFog)\nLIMITED_ADDITION：farFog + max(farFog, heightFog)\nMULTIPLY_ADDITION：farFog + farFog * heightFog\nINVERSE_MULTIPLY_ADDITION：farFog + 1 - (1-heightFog) * (1-farFog)\nAVERAGE：farFog*0.5 + heightFog*0.5",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogDirection": "高度雾方向",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogDirection.@tooltip": "高度雾应位于何处？\n\nABOVE_CAMERA：高度雾从相机延伸至天空\nBELOW_CAMERA：高度雾从相机延伸至虚空\nABOVE_AND_BELOW_CAMERA：高度雾从相机同时延伸至天空和虚空\nABOVE_SET_HEIGHT：高度雾从设定高度延伸至天空\nBELOW_SET_HEIGHT：高度雾从设定高度延伸至虚空\nABOVE_AND_BELOW_SET_HEIGHT：高度雾从设定高度同时延伸至天空和虚空\n",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogBaseHeight": "高度雾基准高度",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogBaseHeight.@tooltip": "如果高度雾围绕设定高度计算，该高度位置是多少？",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogStart": "高度雾起始",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogStart.@tooltip": "高度雾的起始应偏移多远？\n\n  '0.0'：雾起始无偏移。\n  '1.0'：雾起始偏移整个世界高度。（包括深度）\n",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogEnd": "高度雾终止",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogEnd.@tooltip": "高度雾的终止应偏移多远？\n\n  '0.0'：雾终止无偏移。\n  '1.0'：雾终止偏移整个世界高度。（包括深度）\n",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMin": "高度雾最小值",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMin.@tooltip": "雾的最小浓度是多少？\n\n  '0.0'：完全没有雾。\n  '1.0'：完全为雾颜色。\n",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMax": "高度雾最大值",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMax.@tooltip": "雾的最大浓度是多少？\n\n  '0.0'：完全没有雾。\n  '1.0'：完全为雾颜色。\n",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogFalloff": "高度雾衰减",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogFalloff.@tooltip": "高度雾浓度应如何计算？\n\nLINEAR：基于高度的线性计算（将忽略 'density'）\nEXPONENTIAL：1/(e^(height*density))\nEXPONENTIAL_SQUARED：1/(e^((height*density)^2))\n",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogDensity": "高度雾密度",
 "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogDensity.@tooltip": "高度雾的密度是多少？",
 "distanthorizons.config.client.advanced.graphics.texture": "LOD 纹理",
 "distanthorizons.config.client.advanced.graphics.texture.enableTexturedLods": "启用 LOD 纹理",
 "distanthorizons.config.client.advanced.graphics.texture.enableTexturedLods.@tooltip": "启用后，近距离和变焦状态下的 LOD 将使用其方块的\n真实纹理和轮廓渲染，而不是单一纯色。\n\n仅适用于纹理实际可见的高细节 LOD，\n远处的 LOD 始终使用纯色。\n启用光影包时无效，因为光影包\n使用自己的程序渲染 LOD。",
 "distanthorizons.config.client.advanced.graphics.texture.maxTexturedLodDetailLevel": "最大纹理细节等级",
 "distanthorizons.config.client.advanced.graphics.texture.maxTexturedLodDetailLevel.@tooltip": "可使用方块纹理渲染的最高细节等级。\n在更高的细节等级下，每个 LOD 覆盖多个方块，\n纹理会小于一个像素因而不可见。\n\n更大的数值会让更远的 LOD 使用纹理，\n但会增加内存占用。",
 "distanthorizons.config.client.advanced.graphics.texture.blocksDontRenderTextureCsv": "不渲染纹理的方块",
 "distanthorizons.config.client.advanced.graphics.texture.blocksDontRenderTextureCsv.@tooltip": "以逗号分隔的方块资源位置列表，\nDH 不会在其上渲染纹理。\n部分匹配/不完整的资源位置也会生效。\n\n示例：\"minecraft:grass_block,nylium\"\n\n更改需要重启游戏。",
 "distanthorizons.config.client.advanced.graphics.texture.blocksDontUseSideTextureCsv": "不使用侧面纹理的方块",
 "distanthorizons.config.client.advanced.graphics.texture.blocksDontUseSideTextureCsv.@tooltip": "以逗号分隔的方块资源位置列表，\nDH 将使用底面纹理渲染其侧面。\n部分匹配/不完整的资源位置也会生效。\n\n示例：\"minecraft:grass_block,nylium\"\n\n更改需要重启游戏。",
 "distanthorizons.config.client.advanced.graphics.texture.blockTagsDontUseSideTextureCsv": "不使用侧面纹理的方块标签",
 "distanthorizons.config.client.advanced.graphics.texture.blockTagsDontUseSideTextureCsv.@tooltip": "以逗号分隔的标签名称列表，\nDH 将使用底面纹理渲染其侧面。\n\n示例：\"grass_blocks,nylium\"\n\n更改需要重启游戏。",
 "distanthorizons.config.client.advanced.graphics.texture.blocksAlwaysRasterizeTextureCsv": "始终光栅化纹理的方块",
 "distanthorizons.config.client.advanced.graphics.texture.blocksAlwaysRasterizeTextureCsv.@tooltip": "以逗号分隔的方块资源位置列表，\nDH 将使用光栅化来确定\n其面纹理。\n\n可用于修复某些模组/方块侧面\n仅使用模型方块纹理一部分的问题。\n\n示例：\"minecraft:beacon\"\n\n更改需要重启游戏。",
 "distanthorizons.config.client.advanced.graphics.noiseTexture": "噪点纹理",
 "distanthorizons.config.client.advanced.graphics.noiseTexture.enableNoiseTexture": "启用噪点纹理",
 "distanthorizons.config.client.advanced.graphics.noiseTexture.enableNoiseTexture.@tooltip": "启用后，将在 LOD 上应用噪点纹理以模拟纹理效果。",
 "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseSteps": "噪点阶数",
 "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseSteps.@tooltip": "决定应用于 LOD 的噪点阶数。",
 "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseIntensity": "噪点强度",
 "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseIntensity.@tooltip": "决定噪点纹理的强度。",
 "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseDropoff": "噪点衰减距离",
 "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseDropoff.@tooltip": "定义噪点纹理在淡出前的渲染距离。（以方块为单位）\n设为 0 可禁用噪点淡出。",
 "distanthorizons.config.client.advanced.graphics.culling": "剔除",
 "distanthorizons.config.client.advanced.graphics.culling.overdrawPrevention": "过度绘制预防",
 "distanthorizons.config.client.advanced.graphics.culling.overdrawPrevention.@tooltip": "决定 Distant Horizons 在距相机多远处开始渲染。\n以原版渲染距离的百分比计算。\n-1 = 自动，过度绘制会根据原版渲染距离变化。\n\n更高的数值会在更远的距离防止 LOD 渲染在原版方块之后，\n但可能导致 LOD 中出现空洞。\n空洞最有可能在飞越未加载地形时出现。\n\n提高原版渲染距离可增强此设置的效果。",
 "distanthorizons.config.client.advanced.graphics.culling.reduceOverdrawWithFastMovement": "快速移动时减少过度绘制",
 "distanthorizons.config.client.advanced.graphics.culling.reduceOverdrawWithFastMovement.@tooltip": "启用后，在快速飞行/移动时，过度绘制预防半径\n会更靠近相机。\n\n这有助于缓解 Minecraft 加载或生成区块的速度\n跟不上 DH 的问题。",
 "distanthorizons.config.client.advanced.graphics.culling.enableCaveCulling": "启用洞穴剔除",
 "distanthorizons.config.client.advanced.graphics.culling.enableCaveCulling.@tooltip": "启用后，洞穴将被剔除。\n\n补充信息：目前此功能会在没有天花板（顶盖）的维度中，\n剔除洞穴剔除高度以下\n所有天光值为 0 的面。\n",
 "distanthorizons.config.client.advanced.graphics.culling.caveCullingHeight": "洞穴剔除高度",
 "distanthorizons.config.client.advanced.graphics.culling.caveCullingHeight.@tooltip": "洞穴剔除应从哪个 Y 值开始？",
 "distanthorizons.config.client.advanced.graphics.culling.disableBeaconDistanceCulling": "启用信标距离剔除",
 "distanthorizons.config.client.advanced.graphics.culling.disableBeaconDistanceCulling.@tooltip": "启用后，相机附近的信标将不会被绘制，以防止原版过度绘制。\n禁用后将渲染所有信标。",
 "distanthorizons.config.client.advanced.graphics.culling.disableFrustumCulling": "禁用视锥体剔除",
 "distanthorizons.config.client.advanced.graphics.culling.disableFrustumCulling.@tooltip": "禁用（false）时，玩家视野外的 LOD\n不会被绘制，从而提高 GPU 性能。\n\n启用（true）时，所有 LOD 都会被绘制，\n包括玩家视野背后的 LOD，从而降低 GPU 性能。\n\n如果你发现 LOD 在视野边缘消失，请禁用此项。",
 "distanthorizons.config.client.advanced.graphics.culling.disableShadowPassFrustumCulling": "禁用阴影通道视锥体剔除",
 "distanthorizons.config.client.advanced.graphics.culling.disableShadowPassFrustumCulling.@tooltip": "与另一个视锥体剔除选项相同，区别在于它仅在\n使用 DH API 的光影模组存在\n且正在渲染阴影通道时使用。\n\n如果阴影渲染不正确，请禁用此项。",
 "distanthorizons.config.client.advanced.graphics.culling.ignoredRenderBlockCsv": "忽略渲染的方块 CSV",
 "distanthorizons.config.client.advanced.graphics.culling.ignoredRenderBlockCsv.@tooltip": "以逗号分隔的方块资源位置列表，DH 不会渲染这些方块。\n空气始终包含在此列表中。\n\n注意：\n如果你看到缝隙或空洞，可能需要将\nworldCompression 更改为 [MERGE_SAME_BLOCKS] 并重新生成 LOD。",
 "distanthorizons.config.client.advanced.graphics.culling.ignoredRenderCaveBlockCsv": "忽略渲染的洞穴方块 CSV",
 "distanthorizons.config.client.advanced.graphics.culling.ignoredRenderCaveBlockCsv.@tooltip": "以逗号分隔的方块资源位置列表，当这些方块\n位于天光值为 0 的地下区域时不会被渲染。\n空气始终包含在此列表中。\n\n默认为空列表，因为大多数洞穴方块会因以下特性被自动忽略：\n透明、非固体或液体，但如有需要可在此添加新方块。",
 "distanthorizons.config.client.advanced.graphics.culling.waterSubSurfaceBlockReplacementCsv": "水面下方方块替换",
 "distanthorizons.config.client.advanced.graphics.culling.waterSubSurfaceBlockReplacementCsv.@tooltip": "以逗号分隔的方块资源位置列表，当这些方块\n在水面可见时将被替换为水。",
 "distanthorizons.config.client.advanced.graphics.culling.waterSurfaceBlockReplacementCsv": "水面方块替换",
 "distanthorizons.config.client.advanced.graphics.culling.waterSurfaceBlockReplacementCsv.@tooltip": "以逗号分隔的方块资源位置列表，当这些方块\n位于水面上时将被移除。",
 "distanthorizons.config.client.advanced.graphics.culling.blocksToIgnore": "要忽略的方块",
 "distanthorizons.config.client.advanced.graphics.culling.blocksToIgnore.@tooltip": "定义哪些方块应渲染为 LOD。\n\n§NONE：§r 在 LOD 中包含所有方块\n§NON_COLLIDING：§r 仅在 LOD 中渲染固体方块（草丛、火把等将被忽略）",
 "distanthorizons.config.client.advanced.graphics.culling.tintWithAvoidedBlocks": "使用被忽略方块着色",
 "distanthorizons.config.client.advanced.graphics.culling.tintWithAvoidedBlocks.@tooltip": "§4注意：会让雪、地毯和活板门看起来非常糟糕§r\n被忽略方块下方的方块是否应获得被忽略方块的颜色？\n§6启用：§r 草地上的红花会将其下方的草染成红色\n§6禁用：§r 被跳过的方块不会改变其下方表面的颜色",
 "distanthorizons.config.client.advanced.graphics.overrideVanillaGraphicsSettings": "覆盖原版设置",
 "distanthorizons.config.client.advanced.graphics.overrideVanillaGraphicsSettings.@tooltip": "启用后，在 DH 初始化期间会自动更改部分原版图形设置\n以提供更好的体验。\n\n例如禁用原版云（会渲染在 DH LOD 之上），\n以及区块渐隐（DH 已对 MC 区块进行渐隐）。",
 "distanthorizons.config.client.advanced.graphics.experimental": "实验性",
 "distanthorizons.config.client.advanced.graphics.experimental.earthCurveRatio": "地球曲率比",
 "distanthorizons.config.client.advanced.graphics.experimental.earthCurveRatio.@tooltip": "数值 1 相当于现实中的地球曲率。\n可接受的最小值为 50，最大值为 5000。\n1 到 49 之间的所有数值都会被向上取整为 50。",
 "distanthorizons.config.client.advanced.graphics.experimental.ignoredDimensionCsv": "忽略的维度 CSV",
 "distanthorizons.config.client.advanced.graphics.experimental.ignoredDimensionCsv.@tooltip": "以逗号分隔的维度资源位置列表，DH 不会在这些维度中渲染。示例：\"minecraft:the_nether,minecraft:the_end\"\n\n对于 Minecraft 1.12.2 及更旧版本：\n打开 F3 界面并复制以黄色显示的 dimension_name:ID。示例：\"overworld:0\"\n\n注意：\n在 DH 渲染被禁用时，部分 DH 设置将被禁用\n和/或更改以改善视觉效果。",
 "distanthorizons.config.client.advanced.graphics.experimental.renderingEngine": "渲染引擎",
 "distanthorizons.config.client.advanced.graphics.experimental.renderingEngine.@tooltip": "更改需要重启游戏。",
 "distanthorizons.config.client.advanced.autoUpdater": "自动更新器",
 "distanthorizons.config.client.advanced.autoUpdater.enableAutoUpdater": "启用自动更新",
 "distanthorizons.config.client.advanced.autoUpdater.enableSilentUpdates": "启用静默更新",
 "distanthorizons.config.client.advanced.autoUpdater.enableSilentUpdates.@tooltip": "当有可用更新时自动更新该模组",
 "distanthorizons.config.client.advanced.autoUpdater.updateBranch": "更新分支",
 "distanthorizons.config.client.advanced.autoUpdater.updateBranch.@tooltip": "从何处下载最新更新。\n\nAuto：根据当前 jar 文件下载稳定版或夜间版。\nStable：来自 Modrinth 的稳定版本。\nNightly：来自 Gitlab 的夜间版本。",
 "distanthorizons.config.client.advanced.multiplayer": "多人游戏",
 "distanthorizons.config.client.advanced.multiplayer.serverFolderNameMode": "服务器文件夹模式",
 "distanthorizons.config.client.advanced.multiplayer.serverFolderNameMode.@tooltip": "决定本地多人游戏数据的文件夹格式。\n\n§6仅名称：§r\n使用服务器列表中的名称。例：\"Minecraft Server\"\n§6仅 IP：§r\n\"192.168.1.40\"\n§6名称 IP：§r\n\"Minecraft Server, IP 192.168.1.40\"\n§6名称、IP、端口：§r\n\"Minecraft Server, IP 192.168.1.40:25565\"\n§6名称、IP、端口、MC 版本：§r\n\"Minecraft Server, IP 192.168.1.40:25565, GameVersion 1.18.1\"\n\n§c§l注意：§r 连接多人服务器时更改此选项可能导致异常。",
 "distanthorizons.config.client.advanced.debugging": "调试",
 "distanthorizons.config.client.advanced.debugging.rendererMode": "渲染器模式",
 "distanthorizons.config.client.advanced.debugging.debugRenderingColors": "调试渲染颜色",
 "distanthorizons.config.client.advanced.debugging.lodOnlyMode": "仅渲染 LOD",
 "distanthorizons.config.client.advanced.debugging.lodOnlyMode.@tooltip": "启用后将禁用（大部分）原版 Minecraft 渲染。\n\n注意：在此模式开启时不要报告任何问题！\n此设置仅供娱乐和调试。\n不保证模组兼容性。",
 "distanthorizons.config.client.advanced.debugging.renderWireframe": "渲染线框",
 "distanthorizons.config.client.advanced.debugging.renderWireframe.@tooltip": "启用后，LOD 将以线框形式渲染。",
 "distanthorizons.config.client.advanced.debugging.enableDebugKeybindings": "启用调试按键绑定",
 "distanthorizons.config.client.advanced.debugging.enableDebugKeybindings.@tooltip": "启用后，可以使用多个按键切换调试状态。\nF6 - 启用/禁用 LOD 渲染\nF7 - 启用/禁用仅 LOD 渲染\nF8 - 循环切换不同的调试渲染模式",
 "distanthorizons.config.client.advanced.debugging.enableWhiteWorld": "启用白色世界",
 "distanthorizons.config.client.advanced.debugging.enableWhiteWorld.@tooltip": "启用后，顶点颜色将不会被传递。\n有助于调试着色器。",
 "distanthorizons.config.client.advanced.debugging.showOverlappingQuadErrors": "显示重叠四边形错误",
 "distanthorizons.config.client.advanced.debugging.showOverlappingQuadErrors.@tooltip": "启用后，重叠的四边形将以亮红色渲染，便于识别。\n禁用后，四边形将正常渲染。",
 "distanthorizons.config.client.advanced.debugging.logBufferGarbageCollection": "记录缓冲区垃圾回收",
 "distanthorizons.config.client.advanced.debugging.logBufferGarbageCollection.@tooltip": "启用后，将记录 OpenGL 缓冲区的垃圾回收，\n其中还包括活动缓冲区的数量。",
 "distanthorizons.config.client.advanced.debugging.allowUnsafeValues": "允许不安全的界面值",
 "distanthorizons.config.client.advanced.debugging.allowUnsafeValues.@tooltip": "启用后，将仅执行非常有限的配置输入验证。\n\n警告：启用此选项可能导致不稳定或崩溃，风险自负。\n注意：此选项不会在会话之间保存。",
 "distanthorizons.config.client.advanced.debugging.debugWireframe": "调试线框",
 "distanthorizons.config.client.advanced.debugging.debugWireframe.enableRendering": "启用调试线框渲染",
 "distanthorizons.config.client.advanced.debugging.debugWireframe.enableRendering.@tooltip": "启用后，将绘制各种用于调试内部功能的线框。",
 "distanthorizons.config.client.advanced.debugging.debugWireframe.showWorldGenQueue": "显示世界生成队列",
 "distanthorizons.config.client.advanced.debugging.debugWireframe.showNetworkSyncOnLoadQueue": "显示网络加载同步队列",
 "distanthorizons.config.client.advanced.debugging.debugWireframe.showRenderSectionStatus": "显示渲染区段状态",
 "distanthorizons.config.client.advanced.debugging.debugWireframe.showRenderSectionToggling": "显示渲染区段切换",
 "distanthorizons.config.client.advanced.debugging.debugWireframe.showQuadTreeRenderStatus": "显示四叉树渲染状态",
 "distanthorizons.config.client.advanced.debugging.debugWireframe.showFullDataUpdateStatus": "显示完整数据更新状态",
 "distanthorizons.config.client.advanced.debugging.openGl": "OpenGL",
 "distanthorizons.config.client.advanced.debugging.openGl.overrideVanillaGLLogger": "覆盖原版 GL 日志记录器",
 "distanthorizons.config.client.advanced.debugging.openGl.overrideVanillaGLLogger.@tooltip": "定义 OpenGL 错误的处理方式。\n更改需要重启 Minecraft。\n会捕获其他模组抛出的 OpenGL 错误。",
 "distanthorizons.config.client.advanced.debugging.openGl.onlyLogGlErrorsOnce": "仅记录一次 GL 错误",
 "distanthorizons.config.client.advanced.debugging.openGl.onlyLogGlErrorsOnce.@tooltip": "启用后，每个 OpenGL 错误只会被记录一次。\n启用此项可能会遗漏一些错误日志。\n若 overrideVanillaGLLogger 设为 false 则无效。\n\n通常可以保持 'true' 以防止日志刷屏。\n但如果开发者需要你的日志来调试 GL 问题，请将其设为 'false'。\n",
 "distanthorizons.config.client.advanced.debugging.openGl.glErrorHandlingMode": "OpenGL 错误处理模式",
 "distanthorizons.config.client.advanced.debugging.openGl.glErrorHandlingMode.@tooltip": "定义 OpenGL 错误的处理方式。\n 需要重启 Minecraft 才能生效。\n可能会错误地捕获其他模组抛出的 OpenGL 错误。",
 "distanthorizons.config.client.advanced.debugging.columnBuilderDebugging": "渲染列构建器",
 "distanthorizons.config.client.advanced.debugging.columnBuilderDebugging.columnBuilderDebugEnable": "启用列构建器限制",
