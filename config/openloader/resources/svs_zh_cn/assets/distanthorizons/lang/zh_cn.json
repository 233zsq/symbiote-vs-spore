 "distanthorizons.config.common.logging.warning.showPoolInsufficientMemoryWarning.@tooltip": "如果 DH 检测到池化对象被垃圾回收，将发送聊天警告。",
 "distanthorizons.config.common.logging.warning.showHighVanillaRenderDistanceWarning": "显示原版渲染距离过高警告",
