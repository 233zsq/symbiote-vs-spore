 "distanthorizons.config.server": "服务器",
 "distanthorizons.config.server.sendLevelKeys": "发送世界密钥",
 "distanthorizons.config.server.sendLevelKeys.@tooltip": "让服务器为每个世界发送世界密钥。\n如果你使用其他方式发送世界密钥，请禁用此项。",
 "distanthorizons.config.server.levelKeyPrefix": "世界密钥前缀",
 "distanthorizons.config.server.levelKeyPrefix.@tooltip": "发送到客户端的世界密钥前缀。\n如果模组在代理后运行，每个后端应使用唯一的值。\n如果此值为空，世界密钥将基于服务器的种子哈希。",
 "distanthorizons.config.server.generationRequestRateLimit": "生成请求速率限制",
 "distanthorizons.config.server.generationRequestRateLimit.@tooltip": "客户端每秒应发送多少个 LOD 生成请求？\n同时限制允许留在服务器队列中的客户端请求数量。",
 "distanthorizons.config.server.maxGenerationRequestDistance": "最大生成请求距离",
 "distanthorizons.config.server.maxGenerationRequestDistance.@tooltip": "定义允许在玩家周围生成的距离。",
 "distanthorizons.config.server.enableRealTimeUpdates": "启用实时更新",
 "distanthorizons.config.server.enableRealTimeUpdates.@tooltip": "启用后，客户端将接收客户端渲染距离外区块的实时 LOD 更新。",
 "distanthorizons.config.server.realTimeUpdateDistanceRadiusInChunks": "实时更新半径（区块）",
 "distanthorizons.config.server.realTimeUpdateDistanceRadiusInChunks.@tooltip": "定义玩家接收更新的周围距离。",
 "distanthorizons.config.server.synchronizeOnLoad": "加载时同步 LOD",
 "distanthorizons.config.server.synchronizeOnLoad.@tooltip": "启用后，客户端在加入或加载新 LOD 时将接收更新后的 LOD。",
 "distanthorizons.config.server.syncOnLoadRateLimit": "加载同步速率限制",
 "distanthorizons.config.server.syncOnLoadRateLimit.@tooltip": "客户端每秒应发送多少个 LOD 同步请求？\n同时限制允许留在服务器队列中的客户端请求数量。",
 "distanthorizons.config.server.maxSyncOnLoadRequestDistance": "最大加载同步请求距离",
 "distanthorizons.config.server.maxSyncOnLoadRequestDistance.@tooltip": "定义允许在玩家周围同步的距离。\n大多数情况下应等于或大于 maxGenerationRequestDistance。",
 "distanthorizons.config.server.playerBandwidthLimit": "每玩家带宽限制（KB/s）",
 "distanthorizons.config.server.playerBandwidthLimit.@tooltip": "向客户端上传 LOD 的每玩家最大速度，单位为 KB/s。\n设为 0 表示不限制。",
 "distanthorizons.config.server.globalBandwidthLimit": "全局带宽限制（KB/s）",
 "distanthorizons.config.server.globalBandwidthLimit.@tooltip": "向客户端上传 LOD 的全局最大速度，单位为 KB/s。\n设为 0 表示不限制。",
 "distanthorizons.config.server.enableAdaptiveTransferSpeed": "启用自适应传输速度",
 "distanthorizons.config.server.enableAdaptiveTransferSpeed.@tooltip": "根据客户端性能启用自适应传输速度。\n启用后，DH 将自动调整传输速率以减少连接延迟。\n禁用后，传输速度将保持固定。",
