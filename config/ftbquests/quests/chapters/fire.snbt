  "quests": [
    {
      "id": "000732027C060895",
      "title": "普通火药烧不完菌潮",
      "description": [
        "【战略目标】感染已经爬进军营、医院和实验室。你要取走的不是又一把普通火剑，而是旧防线一直没能守住的原初火种。",
        "【讨伐作业】阅读本次行动命令，确认后展开下一步。",
        "【情报与机制】先反杀追来的猎手，再连续突破狱火骑士、炼狱飞龙与原初受火者；劫火的战斗运用单列，不用阅读假装赋能所有炮塔。",
        "【掠夺战果】下一项就是本战区的第一步行动。"
      ],
      "icon": {
        "id": "ftbquests:custom_icon",
