  "quests": [
    {
      "id": "00070DD0C70F5BC7",
      "title": "旧王回响，名器与技法",
      "description": [
        "【战略目标】旧纪元英雄不在野外游荡。它们的回响属于独立召唤挑战，将王魂与武装带回主战场。",
        "【讨伐作业】阅读本次行动命令，确认后展开下一步。",
        "【情报与机制】封印石自然投放关闭，召唤入口未开放。这里不赠召唤物、不恢复野刷。",
        "【掠夺战果】后续挑战保留真实胜利条件；入口开放后逐场进行。"
      ],
      "icon": {
        "id": "ftbquests:custom_icon",
        "Count": 1,
        "tag": {
          "Icon": "svs:textures/quest/emblems/command.png"
        }
      },
      "subtitle": "独立目标",
      "x": 0.0,
      "y": 0.0,
      "size": 1.0,
      "shape": "circle",
      "dependencies": [
        "0000067095304813"
      ],
