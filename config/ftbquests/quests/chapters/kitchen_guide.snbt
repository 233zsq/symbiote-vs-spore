	quests: [
		{
			description: [
				"想在孢子天灾下活得滋润，先得把灶支起来。"
				"农夫乐事的「烹饪锅」是一切料理的起点——砖块与铁料按 JEI 合成，锅底还需热源（营火/熔炉皆可）。"
				"放入食材与容器，静候锅中咕嘟作响。"
			]
			id: "5DC986BECA9ECDCF"
			shape: "circle"
			subtitle: "炉火起处，方为营地"
			tasks: [{
				id: "44AC4872CD5B1078"
				item: "farmersdelight:cooking_pot"
				type: "item"
			}]
			title: "安家先安灶"
			x: 0.0d
			y: 0.0d
		}
		{
			description: [
				"「煎锅」是冒险者的移动厨房：几块铁锭与木棍即可锻成（合成见 JEI）。"
				"一手煎锅一手生肉，对准营火翻煎，逃命路上也能吃上热食。"
				"残血被追时边跑边煎——这是共生体宿主也要会的手艺。"
			]
			id: "0C60946AF3F51620"
			shape: "circle"
			subtitle: "随身灶台，边走边吃"
			tasks: [{
				id: "2AEA78D3D2EEBE60"
